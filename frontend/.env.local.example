# Base URL of the NestJS backend (see ../backend or the repo root).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Supabase project — used for a direct browser-side connection (e.g. Supabase
# Auth). Safe to expose publicly: this is the publishable/anon key, gated by
# Row Level Security on the Supabase project, not by keeping it secret.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
