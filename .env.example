NODE_ENV=development
PORT=3000

# All variables below (except SUPABASE_DB_URL and FRONTEND_ORIGIN) are
# validated at application startup — see src/config/configuration.schema.ts.
# A missing or invalid value fails startup immediately with a clear message
# listing every problem, rather than starting and failing on first use.

# Supabase project credentials.
# Find these in Supabase dashboard > Project Settings > API.
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Server-side only. Bypasses Row Level Security — never expose to a client.
SUPABASE_SERVICE_ROLE_KEY=
# Used only by `npm run supabase:schema` to apply supabase/migrations/*.sql.
# Find it in Supabase dashboard > Project Settings > Database > Connection string
# (the "Shared pooler", session mode / port 5432 works well for one-off scripts like this).
SUPABASE_DB_URL=postgresql://postgres.<your-project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Default customer used to seed the Customer row and drive synchronization
# when no customerId is supplied to POST /sync/users.
CUSTOMER_API_BASE_URL=https://assessment-api-gamma.vercel.app
CUSTOMER_API_TOKEN=
CUSTOMER_NAME=Assessment API

# HTTP client tuning for the customer API integration.
CUSTOMER_API_TIMEOUT_MS=10000
CUSTOMER_API_MAX_RETRIES=3
CUSTOMER_API_PAGE_SIZE=100

# Optional cron expression to run synchronization automatically.
# Leave empty to disable scheduled sync. Example: every 15 minutes.
SYNC_CRON=

# Origin allowed to make cross-origin requests to this API (CORS). Set to
# your frontend's URL, e.g. https://app.example.com. Leave empty to disable
# all cross-origin browser access (same-origin and non-browser clients are
# unaffected).
FRONTEND_ORIGIN=http://localhost:3001
