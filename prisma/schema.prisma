generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SyncRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum UserStatus {
  active
  invited
  suspended
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  /// Human-readable internal customer name (e.g. "Assessment API").
  name      String
  /// Base URL of this customer's external API. Kept per-customer so the
  /// integration can support multiple customers without code changes.
  apiBaseUrl String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users    User[]
  syncRuns SyncRun[]
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  customerId     String     @db.Uuid
  /// Stable identifier from the customer's system (their `id`). Never reused
  /// as our own primary key so we can freely change our internal ID strategy.
  externalUserId String
  name           String
  email          String
  phone          String?
  status         UserStatus @default(active)

  // Company is flattened rather than modeled as its own table: it has no
  /// independent lifecycle in this domain, and flattening keeps the useful
  /// `company` filter a simple indexed column instead of a join.
  companyName      String?
  companyIndustry  String?
  companyRole      String?
  companyWebsite   String?
  companyEmployees Int?

  /// Timestamps as reported by the customer API (not our own bookkeeping).
  externalCreatedAt DateTime @db.Timestamptz(3)
  externalUpdatedAt DateTime @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  /// Soft-deletion marker. Set when a previously synced user no longer
  /// appears in the customer API's dataset; cleared if it reappears.
  deletedAt DateTime? @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([customerId, externalUserId])
  @@index([customerId, companyName])
  @@index([customerId, updatedAt])
  @@index([customerId, deletedAt])
}

model SyncRun {
  id             String        @id @default(uuid()) @db.Uuid
  customerId     String        @db.Uuid
  status         SyncRunStatus @default(RUNNING)
  startedAt      DateTime      @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?     @db.Timestamptz(3)
  recordsFetched Int?
  recordsCreated Int?
  recordsUpdated Int?
  recordsDeleted Int?
  errorCode      String?
  errorMessage   String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([customerId, startedAt])
  @@index([customerId, status])
}
